# ==============================================================================
# Blog API Environment Configuration (.env.example)
# Copy this file to .env and customize values for local development or deployment.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/blog
SPRING_DATASOURCE_USERNAME=blog
SPRING_DATASOURCE_PASSWORD=blog

# Spring Active Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# JWT Security
BLOG_JWT_ISSUER=blog-api
BLOG_JWT_PRIVATE_KEY=
BLOG_JWT_PUBLIC_KEY=

# Spring AI / OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# CORS Configuration
BLOG_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
