# ==============================================================================
# Blog API Environment Configuration (.env.example)
# Copy to .env (never commit .env!) and adjust. Docker Compose reads .env automatically;
# Spring Boot does NOT — export variables or use your IDE's run configuration.
# ==============================================================================

# Database (PostgreSQL) — used by compose.yaml
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog

# Spring profile. Leave empty for local dev; "prod" in production.
# SPRING_PROFILES_ACTIVE=

# JWT (see #18) — PEM-encoded keys, only required in prod
BLOG_JWT_ISSUER=blog-api
BLOG_JWT_PRIVATE_KEY=
BLOG_JWT_PUBLIC_KEY=

# TL;DR model service (see #39 and E-L-R/blog-tldr-model)
TLDR_BASE_URL=http://localhost:8000
TLDR_API_KEY=change-me-local-only

# CORS
BLOG_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
